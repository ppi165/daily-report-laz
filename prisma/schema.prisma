generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// Kumpulan Model untuk Daily Report LAZ Persis
// ==========================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  password  String
  name      String
  division  String   // Humas, Program, Keuangan, dll
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  reports   Report[]
}

model Report {
  id          String   @id @default(uuid())
  title       String?
  content     String   // Apa yang dikerjakan hari ini
  division    String   // Bidang/Divisi saat melapor
  attachments String[] // Array URL gambar dari Supabase Storage
  status      String   @default("PUBLISHED")
  appreciations Int    @default(0)
  
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
