generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// Kumpulan Model untuk Daily Report LAZ Persis
// ==========================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  password  String
  name      String
  division  String   // Humas, Program, Keuangan, dll
  role      String   @default("STAFF") // "ADMIN", "SUPERVISOR", "STAFF"
  position  String?  @default("Staf Pelaksana")
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  reports   Report[]
  approvals ReportApproval[] @relation("ApproverRelation")
  likes     ReportAppreciation[]
  comments  ReportComment[]
  roleAudits RoleAuditLog[]  @relation("RoleAuditTarget")
}

model Division {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  leaderName  String?  // Nama Koordinator / PJ Bidang
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Report {
  id            String   @id @default(uuid())
  title         String?
  content       String   // Apa yang dikerjakan hari ini
  division      String   // Bidang/Divisi saat melapor
  attachments   String[] // Array URL gambar dari Supabase Storage
  status        String   @default("PUBLISHED") // PUBLISHED, PENDING_APPROVAL, REJECTED
  appreciations Int      @default(0)
  isClockIn     Boolean  @default(false)
  isLate        Boolean  @default(false)
  
  authorId      String
  author        User     @relation(fields: [authorId], references: [id])
  
  approvals     ReportApproval[]
  likes         ReportAppreciation[]
  comments      ReportComment[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ReportAppreciation {
  id        String   @id @default(uuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reportId, userId])
}

model ReportComment {
  id        String          @id @default(uuid())
  reportId  String
  report    Report          @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  parentId  String?
  parent    ReportComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ReportComment[] @relation("CommentReplies")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([parentId])
  @@index([reportId])
}

model ReportApproval {
  id               String    @id @default(uuid())
  reportId         String
  report           Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  
  approverId       String?
  approver         User?     @relation("ApproverRelation", fields: [approverId], references: [id])
  
  approverMockId   String?
  approverName     String
  approverDivision String?
  status           String    @default("PENDING") // PENDING, APPROVED, REJECTED
  note             String?
  respondedAt      DateTime?
  isOverridden     Boolean   @default(false)
  respondedByName  String?
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model SystemSetting {
  id                     String   @id @default("default")
  dailyDeadlineTime      String   @default("17:00")
  reminderTime           String   @default("16:00")
  clockInMaxDays         Int      @default(3)
  clockInRequiredWitness Int      @default(2)
  clockInRequireReason   Boolean  @default(true)
  workDays               String[] @default(["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY"])
  isRamadhanMode         Boolean  @default(false)
  ramadhanDeadlineTime   String   @default("15:30")
  requirePhoto           Boolean  @default(false)
  feedVisibility         String   @default("ALL")
  scheduleRetentionType  String   @default("MONTH") // "MONTH", "YEAR", "NEVER"
  scheduleRetentionValue Int      @default(3)
  updatedAt              DateTime @updatedAt
}

model SpecialSchedule {
  id           String   @id @default(uuid())
  name         String
  startDate    DateTime
  endDate      DateTime
  deadlineTime String
  reminderTime String?
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model RoleAuditLog {
  id         String   @id @default(uuid())
  targetId   String
  target     User     @relation("RoleAuditTarget", fields: [targetId], references: [id], onDelete: Cascade)
  oldRole    String
  newRole    String
  actionType String   @default("DEMOTION") // DEMOTION, PROMOTION, UPDATE
  reason     String
  actorId    String
  actorName  String
  actorRole  String
  createdAt  DateTime @default(now())
}
